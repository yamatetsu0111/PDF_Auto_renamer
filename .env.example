# =================================================================
# PDFリネーム＆ログ記録プログラム 設定テンプレート
# =================================================================
# 各環境（PC）に合わせてパスを書き換えてください。
# ※「Path()」や「r""」などのPythonコードは含めず、純粋なパスのみを記載してください。

# 自社製PDFが格納されているフォルダのルートパス
MY_COMPANY_DIR=フォルダパスを入力

# 他社製PDFが格納されているフォルダのルートパス
COMPANY_DIR=フォルダパスを入力

# 処理結果を出力するCSVログファイルのフルパス
LOG_FILE=C:\Users\your_username\Desktop\rename_log.csv
